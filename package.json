{
  "name": "skill-arena",
  "version": "0.1.0",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "benchmark",
    "promptfoo",
    "codex",
    "copilot",
    "agent-evaluation"
  ],
  "files": [
    "bin/skill-arena.js",
    "src/**/*.js",
    "README.md"
  ],
  "bin": {
    "skill-arena": "./bin/skill-arena.js"
  },
  "description": "CLI-first benchmark harness for comparing agent capability bundles with Promptfoo.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "docs:check": "node scripts/check-docs.js",
    "skills:check": "node scripts/check-skill-bundles.js",
    "check": "npm run docs:check && npm run skills:check && npm test",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --reporter=text --all --include=src/**/*.js --exclude=src/cli/** --exclude=src/runner.js --exclude=src/providers/codex-system-provider.js --exclude=src/providers/pi-system-provider.js --check-coverage --statements 95 --branches 85 --functions 95 --lines 95 node --test test/*.test.js"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.114.0",
    "promptfoo": "^0.121.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
