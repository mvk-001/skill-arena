---
# mermaid-colorset-styler: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#ffccd5"
    primaryTextColor: "#333e48"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#cdf3ff"
    secondaryTextColor: "#333e48"
    secondaryBorderColor: "#007298"
    tertiaryColor: "#e7e7e7"
    tertiaryTextColor: "#333e48"
    tertiaryBorderColor: "#9c9c9c"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#ffffff"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    classText: "#333e48"
    labelColor: "#333e48"
    titleColor: "#333e48"
# mermaid-colorset-styler: config end
# mermaid-colorset-styler: metadata begin
mermaid-colorset-styler:
  colorset: "colorset2"
  palette: "full-color-style"
# mermaid-colorset-styler: metadata end
---
flowchart TB
    start["What evidence can justify the next skill edit?"]:::csPrimary
    lineage{"Repeated parent-child-operator lineage<br/>with multiple established operators?"}:::csWarning
    traces{"Diverse completed traces with<br/>recurring lessons across tasks?"}:::csWarning
    structure{"What remaining evidence structure<br/>can drive selection?"}:::csWarning

    operator["harbor-operator-coevolution<br/>Credit mutation instructions by parent-to-child gain"]:::csSpecial
    trace["harbor-trace-distillation<br/>Consolidate independently supported patches"]:::csSpecial
    gepa["Train feedback + validation split<br/>harbor-evolve-skill"]:::csSpecial
    pareto["Case-local diagnoses + conflicting strengths<br/>harbor-reflective-pareto-search"]:::csSpecial
    population["Stable scalar + several candidates<br/>harbor-population-search"]:::csSpecial
    enrich["No sufficient evidence<br/>Inspect jobs and strengthen the evaluation contract"]:::csMuted
    holdout["Freeze one development selection;<br/>compare baseline and candidate on untouched holdout"]:::csSuccess

    start --> lineage
    lineage -->|Yes| operator
    lineage -->|No| traces
    traces -->|Yes| trace
    traces -->|No| structure
    structure -->|Integrated text optimizer| gepa
    structure -->|Per-case vector| pareto
    structure -->|Scalar fitness| population
    structure -->|None| enrich
    operator --> holdout
    trace --> holdout
    gepa --> holdout
    pareto --> holdout
    population --> holdout
  classDef csPrimary fill:#ffccd5,stroke:#9e1b32,color:#333e48,stroke-width:2px;
  classDef csMuted fill:#e7e7e7,stroke:#828282,color:#333e48,stroke-width:2px;
  classDef csWarning fill:#ffe5cc,stroke:#e77204,color:#333e48,stroke-width:2px;
  classDef csSuccess fill:#dbffcc,stroke:#45842a,color:#333e48,stroke-width:2px;
  classDef csSpecial fill:#f9ccff,stroke:#652f6c,color:#333e48,stroke-width:2px;
