---
flowchart LR
    T1["Import diverse completed Harbor<br/>success and failure traces"]:::csMuted
    T2["Author bounded diagnoses and<br/>cite exact discovery evidence"]:::csInfo
    T3["Require support from at least<br/>2 trials and 2 task checksums"]:::csAccent
    T4["Resolve conflicts; consolidate only<br/>supported bundle patches"]:::csSpecial
    T5["Materialize one candidate;<br/>baseline-versus-candidate holdout"]:::csSuccess
    T1 --> T2 --> T3 --> T4 --> T5
  classDef csAccent fill:#cdf3ff,stroke:#007298,color:#333e48,stroke-width:2px;
  classDef csMuted fill:#e7e7e7,stroke:#828282,color:#333e48,stroke-width:2px;
  classDef csSuccess fill:#dbffcc,stroke:#45842a,color:#333e48,stroke-width:2px;
  classDef csInfo fill:#cdf3ff,stroke:#00ace6,color:#333e48,stroke-width:2px;
  classDef csSpecial fill:#f9ccff,stroke:#652f6c,color:#333e48,stroke-width:2px;
