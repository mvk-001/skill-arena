---
# mermaid-colorset-styler: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#ffccd5"
    primaryTextColor: "#333e48"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#cdf3ff"
    secondaryTextColor: "#333e48"
    secondaryBorderColor: "#007298"
    tertiaryColor: "#e7e7e7"
    tertiaryTextColor: "#333e48"
    tertiaryBorderColor: "#9c9c9c"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#ffffff"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    classText: "#333e48"
    labelColor: "#333e48"
    titleColor: "#333e48"
# mermaid-colorset-styler: config end
# mermaid-colorset-styler: metadata begin
mermaid-colorset-styler:
  colorset: "colorset2"
  palette: "full-color-style"
# mermaid-colorset-styler: metadata end
---
flowchart LR
    P1["Frozen baseline + several<br/>focused candidate bundles"]:::csMuted
    P2["Run equivalent native Harbor<br/>development jobs"]:::csInfo
    P3["Apply required gates and rank<br/>scalar fitness deterministically"]:::csAccent
    P4["Keep top two; create focused<br/>mutation or crossover children"]:::csSpecial
    P5["Freeze one qualified winner;<br/>baseline-versus-winner holdout"]:::csSuccess
    P1 --> P2 --> P3 --> P4 --> P5
    P4 -.->|next generation| P2
  classDef csAccent fill:#cdf3ff,stroke:#007298,color:#333e48,stroke-width:2px;
  classDef csMuted fill:#e7e7e7,stroke:#828282,color:#333e48,stroke-width:2px;
  classDef csSuccess fill:#dbffcc,stroke:#45842a,color:#333e48,stroke-width:2px;
  classDef csInfo fill:#cdf3ff,stroke:#00ace6,color:#333e48,stroke-width:2px;
  classDef csSpecial fill:#f9ccff,stroke:#652f6c,color:#333e48,stroke-width:2px;
