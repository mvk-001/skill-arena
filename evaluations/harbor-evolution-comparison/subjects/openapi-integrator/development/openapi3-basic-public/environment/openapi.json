{
  "openapi": "3.0.3",
  "info": {
    "title": "Warehouse Edge API",
    "version": "1.4.0",
    "description": "Read warehouse health and bin details."
  },
  "servers": [
    {
      "url": "https://warehouse.example.test/v2"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "probe-health",
        "summary": "Probe service health",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/bins/{binId}": {
      "parameters": [
        {
          "name": "binId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read one bin",
        "parameters": [
          {
            "name": "detail",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bin details"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
