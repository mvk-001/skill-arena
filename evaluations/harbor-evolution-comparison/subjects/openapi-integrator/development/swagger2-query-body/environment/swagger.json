{
  "swagger": "2.0",
  "info": {
    "title": "Ledger Relay API",
    "version": "2.0.0",
    "description": "Create and inspect ledger entries."
  },
  "host": "ledger.example.test",
  "basePath": "/api/v3",
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "queryKey": {
      "type": "apiKey",
      "in": "query",
      "name": "access_token"
    }
  },
  "security": [
    {
      "queryKey": []
    }
  ],
  "paths": {
    "/entries": {
      "post": {
        "operationId": "create-entry",
        "summary": "Create a ledger entry",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "type": "integer"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/entries/{entryId}": {
      "get": {
        "summary": "Read a ledger entry",
        "parameters": [
          {
            "name": "entryId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Entry details"
          }
        }
      }
    }
  }
}
